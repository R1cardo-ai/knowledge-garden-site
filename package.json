{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/sync-archive-data.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/sync-archive-data.mjs",
    "build": "vite build --config scripts/vite.local-production.ts",
    "start": "wrangler dev --config .local-build/server/wrangler.json --local",
    "lint": "oxlint app components hooks lib scripts public/ui-kit/assets portable-site next.config.ts vite.config.ts",
    "check:updates": "node scripts/check-updates.mjs",
    "build:validate": "npm run build",
    "build:pages": "node scripts/sync-archive-data.mjs && node scripts/build-pages.mjs",
    "check:production": "node scripts/check-production-http.mjs",
    "test:archive-url": "node scripts/test-archive-url.mjs",
    "test:relations": "node scripts/test-relations.mjs",
    "test:notes": "node scripts/test-note-blocks.mjs",
    "test:reader-outline": "node scripts/test-reader-outline.mjs",
    "test:archive-data": "node scripts/test-archive-data.mjs",
    "test": "npm run test:storage && npm run test:archive-data && npm run test:archive-url && npm run test:archive-position && npm run test:notes && npm run test:reader-outline && npm run test:relations && npm run test:theme && npm run test:document-theme && npm run test:static-theme && npm run test:readouts && npm run check:updates && npm run test:console && npm run test:showcase",
    "test:theme": "node scripts/test-theme-migration.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "format": "oxfmt",
    "test:static-theme": "node scripts/test-static-theme.mjs",
    "test:document-theme": "node scripts/test-document-theme.mjs",
    "test:readouts": "node scripts/test-readouts.mjs",
    "test:archive-position": "node scripts/test-archive-position.mjs",
    "build:github": "node scripts/build-github-pages.mjs",
    "test:showcase": "node scripts/test-showcase.mjs",
    "test:console": "node scripts/test-console.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
